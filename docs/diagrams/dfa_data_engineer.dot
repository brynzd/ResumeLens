    q1 -> q2 [label="SPARK | AIRFLOW"];
    q2 -> q2 [label="SPARK | AIRFLOW"];
    q2 -> q3 [label="POSTGRESQL | SQL"];
    q3 -> q3 [label="POSTGRESQL | SQL"];
    q3 -> q4 [label="GIT"];
    q4 -> q4 [label="GIT"];
}
