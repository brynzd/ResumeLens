digraph FRONTEND_DEVELOPER {
    rankdir=LR;
    node [shape=circle, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=11];
    start [shape=point];
    q4 [shape=doublecircle];
    start -> q0;
    q0 -> q1 [label="JAVASCRIPT | TYPESCRIPT"];
    q1 -> q1 [label="JAVASCRIPT | TYPESCRIPT"];
    q1 -> q2 [label="REACT | ANGULAR | VUE"];
    q2 -> q2 [label="REACT | ANGULAR | VUE"];
    q2 -> q3 [label="CSS | TAILWIND"];
    q3 -> q3 [label="CSS | TAILWIND"];
    q3 -> q4 [label="GIT"];
    q4 -> q4 [label="GIT"];
}
