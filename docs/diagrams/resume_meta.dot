
    digraph textX {
    fontname = "Bitstream Vera Sans"
    fontsize = 8
    node[
        shape=record,
        style=filled,
        fillcolor=aliceblue
    ]
    nodesep = 0.3
    edge[dir=black,arrowtail=empty]


n1[ label="{CandidateProfile|name: STRING\l}"]

n2[ label="{Header|headline: STRING\llocation: STRING\lsummary: STRING\l}"]

n3[ label="{Contact|email: EMAIL\lphone: PHONE\llinkedin: URL\l}"]

n4[ label="{Skills|items: list[Qualification]\l}"]

n5[ label="{Languages|}"]

n6[ label="{Language|name: STRING\llevel: Level\l}"]

n7[ label="{Experiences|}"]

n8[ label="{Experience|role: STRING\lcompany: STRING\llocation: STRING\l}"]

n9[ label="{Task|description: STRING\l}"]

n10[ label="{Period|start: DATE\lend: EndDate\l}"]

n11[ label="{Education|}"]

n12[ label="{Degree|degree: STRING\linstitution: STRING\l}"]

n13[ label="{Classification|}"]

n14[ label="{Result|profile: Profile\lverdict: Verdict\l}"]



n1 -> n2[arrowtail=diamond, dir=both, headlabel="header "]
n1 -> n3[arrowtail=diamond, dir=both, headlabel="contact "]
n1 -> n4[arrowtail=diamond, dir=both, headlabel="skills "]
n1 -> n5[arrowtail=diamond, dir=both, headlabel="languages "]
n1 -> n7[arrowtail=diamond, dir=both, headlabel="experiences "]
n1 -> n11[arrowtail=diamond, dir=both, headlabel="education "]
n1 -> n13[arrowtail=diamond, dir=both, headlabel="classification "]
n5 -> n6[arrowtail=diamond, dir=both, headlabel="items 1..*"]
n7 -> n8[arrowtail=diamond, dir=both, headlabel="items 1..*"]
n8 -> n10[arrowtail=diamond, dir=both, headlabel="period "]
n8 -> n9[arrowtail=diamond, dir=both, headlabel="tasks 1..*"]
n11 -> n12[arrowtail=diamond, dir=both, headlabel="items 1..*"]
n12 -> n10[arrowtail=diamond, dir=both, headlabel="period "]
n13 -> n14[arrowtail=diamond, dir=both, headlabel="items 1..*"]
match_rules [ shape=plaintext, label=< <table>
	<tr>
		<td><b>CANON</b></td><td>[A-Z][A-Z0-9_]*</td>
	</tr>
	<tr>
		<td><b>Comment</b></td><td>\/\/.*$|\/\*[\s\S]*?\*\/</td>
	</tr>
	<tr>
		<td><b>DATE</b></td><td>\d{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12]\d|3[01]))?</td>
	</tr>
	<tr>
		<td><b>EMAIL</b></td><td>[A-Za-z0-9_.+-]+@[A-Za-z0-9-]+\.[A-Za-z0-9.-]+</td>
	</tr>
	<tr>
		<td><b>EndDate</b></td><td>present</td>
	</tr>
	<tr>
		<td><b>Level</b></td><td>native|full_professional|professional|basic</td>
	</tr>
	<tr>
		<td><b>PHONE</b></td><td>\+?[0-9][0-9 ()-]{6,}[0-9]</td>
	</tr>
	<tr>
		<td><b>Profile</b></td><td>FULL_STACK_DEVELOPER|MACHINE_LEARNING_ENGINEER|FRONTEND_DEVELOPER|DATA_ENGINEER|UNQUALIFIED</td>
	</tr>
	<tr>
		<td><b>Qualification</b></td><td>[A-Z][A-Z0-9_]*</td>
	</tr>
	<tr>
		<td><b>URL</b></td><td>https?:\/\/[A-Za-z0-9\-._~:\/?#@!$&amp;&#x27;()*+=%]+</td>
	</tr>
	<tr>
		<td><b>Verdict</b></td><td>ACCEPTED|REJECTED</td>
	</tr>
</table> >]


}
